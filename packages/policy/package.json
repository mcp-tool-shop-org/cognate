{
  "name": "@cognate/policy",
  "version": "0.1.0",
  "description": "AI policy evaluation engine for Cognate — pure functions, no side effects",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm exec tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "cognate",
    "ai-governance",
    "policy-engine",
    "structural-governance"
  ],
  "author": "mcp-tool-shop-org",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cognate/types": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.1",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
