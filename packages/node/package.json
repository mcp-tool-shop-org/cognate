{
  "name": "@cognate/node",
  "version": "0.1.0",
  "description": "HTTP API server for Cognate AI governance",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm exec tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "keywords": [
    "cognate",
    "ai-governance",
    "rest-api",
    "http-server"
  ],
  "author": "mcp-tool-shop-org",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cognate/types": "workspace:*",
    "@cognate/policy": "workspace:*",
    "@cognate/model-registry": "workspace:*",
    "@cognate/agent-identity": "workspace:*",
    "@cognate/prompt-store": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "typescript": "^5.4.0",
    "vitest": "^1.2.0"
  }
}
