{
  "name": "@cognate/civility-kernel",
  "version": "1.1.0",
  "description": "Preference-governed plan selection for Cognate: filter candidate plans by hard constraints, score them by weights, then execute or ask",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm exec tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "cognate",
    "ai-governance",
    "policy",
    "preferences",
    "constraints",
    "decision"
  ],
  "author": "mcp-tool-shop",
  "license": "MIT",
  "homepage": "https://mcp-tool-shop-org.github.io/cognate/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcp-tool-shop-org/cognate.git",
    "directory": "packages/civility-kernel"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cognate/types": "workspace:*",
    "json-canonicalize": "^2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cognate/model-registry": "workspace:*",
    "@mcptoolshop/attestia": "^2.1.3",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.3.0",
    "vitest": "^4.1.12"
  }
}
