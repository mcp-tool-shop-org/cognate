{
  "name": "cognate",
  "version": "0.1.4",
  "private": true,
  "description": "AI governance attestation layer \u2014 structural truth for autonomous systems",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r run test:coverage",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "pnpm -r lint",
    "verify": "pnpm build && pnpm test && pnpm typecheck",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "keywords": [
    "ai-governance",
    "attestation",
    "structural-governance",
    "model-registry",
    "agent-identity",
    "policy-engine",
    "web3"
  ],
  "author": "mcp-tool-shop-org",
  "license": "MIT",
  "homepage": "https://mcp-tool-shop-org.github.io/cognate/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcp-tool-shop-org/cognate.git"
  },
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@mcptoolshop/attestia": "^2.0.2"
  }
}
